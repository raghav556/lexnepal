# Set to "true" for offline UI demo (in-memory mock). Omit or "false" for live Convex.
VITE_USE_MOCK=true

# Convex deployment (required when VITE_USE_MOCK is not true)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Hercules OIDC (Convex auth.config.ts — server-side)
AUTH_PROVIDER=local
HERCULES_OIDC_AUTHORITY=
HERCULES_OIDC_CLIENT_ID=
AUTH_SESSION_COOKIE_NAME=lexnepal_session
AUTH_SESSION_TTL_SECONDS=28800
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3002
PUBLIC_FIRM_SLUG=phase-6-firm-a
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@lexnepal.local

# Optional client-side auth redirect helpers
VITE_HERCULES_OIDC_AUTHORITY=
VITE_HERCULES_OIDC_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# Next.js foundation (server-only unless prefixed NEXT_PUBLIC_)
APP_VERSION=0.1.0
GIT_SHA=local
LOG_LEVEL=info

# Phase 2 runs readiness in foundation mode. Set true only after Phase 3
# supplies DATABASE_URL and a real PostgreSQL connectivity check.
READINESS_REQUIRE_DATABASE=false
# Local native PostgreSQL started by `npm run local:infra:start`.
DATABASE_URL=postgresql://lexnepal:lexnepal_local_dev@127.0.0.1:5433/lexnepal

# Per-domain migration switches. Omitted values default to Convex.
# Switch a domain only after its Next.js endpoints pass parity tests.
VITE_BACKEND_IDENTITY=next
VITE_BACKEND_DOCUMENTS=convex
VITE_BACKEND_CASES=next
VITE_BACKEND_TASKS=convex
VITE_BACKEND_CLIENTS=next
VITE_BACKEND_HEARINGS=convex
VITE_BACKEND_FINANCE=convex
VITE_BACKEND_MESSAGES=convex
VITE_BACKEND_NOTIFICATIONS=convex
VITE_BACKEND_APPOINTMENTS=convex
VITE_BACKEND_CMS=next
VITE_BACKEND_HR=convex
VITE_BACKEND_RESEARCH=convex
VITE_BACKEND_LEADS=convex

# Phase 6 private document storage and scanning
# Local self-hosted MinIO started by `npm run local:infra:start`.
OBJECT_STORAGE_BUCKET=lexnepal-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_SSE=none
AWS_ACCESS_KEY_ID=lexnepal_minio
AWS_SECRET_ACCESS_KEY=lexnepal_minio_local_dev_2026
UPLOAD_INTENT_TTL_SECONDS=3600
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CDR_ENDPOINT=
CDR_API_KEY=

# Phase 7 PostgreSQL-backed worker and scheduler polling
JOB_WORKER_POLL_MS=1000
JOB_SCHEDULER_POLL_MS=15000
