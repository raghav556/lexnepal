# Set to "true" for offline UI demo (in-memory mock). Omit or "false" for live Convex.
VITE_USE_MOCK=true

# Convex deployment (required when VITE_USE_MOCK is not true)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Hercules OIDC (Convex auth.config.ts — server-side)
HERCULES_OIDC_AUTHORITY=
HERCULES_OIDC_CLIENT_ID=

# Optional client-side auth redirect helpers
VITE_HERCULES_OIDC_AUTHORITY=
VITE_HERCULES_OIDC_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=http://localhost:3001/auth/callback
