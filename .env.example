# =============================================================================
# LexNepal local environment configuration
# =============================================================================
# Copy to .env.local and edit.  Uncommented values are actively loaded;
# commented values show the built-in default (used when the key is absent).
# .env.local is git-ignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# "local" uses the built-in Better Auth email/password flow.
# "hercules" delegates to an external OIDC provider (see HERCULES_OIDC_*).
# AUTH_PROVIDER=local                           # default: local

# Required.  Local: any >= 32-char secret.  Production: vault-managed.
# Replace the placeholder before any real auth flow or production use.
# BETTER_AUTH_SECRET=                           # must be set; no default

# Local HTTP is fine.  Production must use https:// (enforced at startup).
# BETTER_AUTH_URL=http://localhost:3001          # default: http://localhost:3001

# Canonical public / CMS tenant slug and display name.  CMS managers must
# belong to this firm.  PUBLIC_FIRM_NAME is used by `npm run db:seed:tenant`.
# PUBLIC_FIRM_SLUG=srimar-law                    # default: srimar-law
# PUBLIC_FIRM_NAME=Srimar Law                   # default: Srimar Law

# Session cookie name and lifetime (seconds).  300 <= TTL <= 2,592,000.
# AUTH_SESSION_COOKIE_NAME=lexnepal_session      # default: lexnepal_session
# AUTH_SESSION_TTL_SECONDS=28800                 # default: 28800 (8 hours)

# --- OIDC (only when AUTH_PROVIDER=hercules) ---
# HERCULES_OIDC_AUTHORITY=                      # optional; URL of the OIDC issuer
# HERCULES_OIDC_CLIENT_ID=                      # optional; client ID registered with the issuer

# --- Auth production guards (see doc/migration/PHASE_AUTH_7_PRODUCTION.md) ---
# NEXT_PUBLIC_SKIP_ROLE_GUARDS=1                # dev only; never set in production
# NEXT_PUBLIC_HIDE_DEMO_ACCOUNTS=1              # hidden automatically when NODE_ENV=production

# --- Client-side auth redirect helpers (Vite) ---
# VITE_HERCULES_OIDC_AUTHORITY=                 # optional; mirrors HERCULES_OIDC_AUTHORITY for the SPA
# VITE_HERCULES_OIDC_CLIENT_ID=                 # optional; mirrors HERCULES_OIDC_CLIENT_ID for the SPA
# VITE_AUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Canonical origin used for email links, CORS, cookie scope, etc.
# APP_PUBLIC_URL=http://localhost:3001           # default: http://localhost:3001

# -----------------------------------------------------------------------------
# Next.js foundation
# -----------------------------------------------------------------------------
# Set automatically by build tooling; override only for special workflows.
# APP_VERSION=0.1.0                              # default: 0.1.0
# GIT_SHA=local                                  # default: local
# LOG_LEVEL=info                                 # default: info  (debug | info | warn | error)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local MySQL is required and is always started by `npm run local:infra:start`.
# Migration files and seeders run against this local instance.
DATABASE_URL=mysql://lexnepal:lexnepal_local_dev@127.0.0.1:3306/lexnepal

# Phase 2 runs readiness in foundation mode (no DB check).
# Set true only after Phase 3 supplies DATABASE_URL and a real connectivity check.
# READINESS_REQUIRE_DATABASE=false               # default: false

# -----------------------------------------------------------------------------
# Email / SMTP (Mailpit in local dev)
# -----------------------------------------------------------------------------
# Default points at the local Mailpit instance started by local:infra:start.
# Set LEXNEPAL_SKIP_SMTP=1 to disable email entirely (jobs record an
# "smtp-skipped" effect instead of sending).
# SMTP_HOST=127.0.0.1                            # default: 127.0.0.1
# SMTP_PORT=1025                                 # default: 1025
# SMTP_FROM=noreply@lexnepal.local               # optional; required in production
# LEXNEPAL_SKIP_SMTP=0                           # default: 0 (set to 1 to skip)

# -----------------------------------------------------------------------------
# Document storage & upload limits
# -----------------------------------------------------------------------------
# Local filesystem root.  Created automatically on first start.
# STORAGE_ROOT=./.local/storage                  # default: ./.local/storage

# Required.  Secret used to sign short-lived download tokens.
# Replace the placeholder before any real upload/download flow or production use.
# STORAGE_DOWNLOAD_TOKEN_SECRET=                 # must be set; no default

# TTL windows for upload intents, upload URLs, and download URLs (seconds).
# UPLOAD_INTENT_TTL_SECONDS=3600                 # default: 3600  (300-86400)
# UPLOAD_URL_TTL_SECONDS=600                     # default: 600   (60-3600)
# DOWNLOAD_URL_TTL_SECONDS=300                   # default: 300   (30-900)

# -----------------------------------------------------------------------------
# ClamAV malware scanning (optional)
# -----------------------------------------------------------------------------
# ClamAV is optional for local development.  When clamd is not installed the
# start script skips it automatically and uploads pass through unscanned.
# Point CLAMAV_HOST at an external instance, or set LEXNEPAL_SKIP_LOCAL_CLAMAV=1
# to suppress the "not installed" warning.
# CLAMAV_HOST=127.0.0.1                          # default: 127.0.0.1 (optional)
# CLAMAV_PORT=3310                               # default: 3310
# LEXNEPAL_SKIP_LOCAL_CLAMAV=0                   # default: 0 (set to 1 to skip)

# -----------------------------------------------------------------------------
# Content Disarm & Reconstruct (optional)
# -----------------------------------------------------------------------------
# When set, uploaded documents are passed through a CDR endpoint before storage.
# CDR_ENDPOINT=                                  # optional; URL of the CDR service
# CDR_API_KEY=                                   # optional; API key for the CDR service

# -----------------------------------------------------------------------------
# Background jobs (worker & scheduler polling)
# -----------------------------------------------------------------------------
# How often the worker polls for jobs and the scheduler checks for due tasks (ms).
# JOB_WORKER_POLL_MS=1000                        # default: 1000   (100-60000)
# JOB_SCHEDULER_POLL_MS=15000                    # default: 15000  (1000-300000)
