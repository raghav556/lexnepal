{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/convex/*": ["./convex/*"],
      "convex/react": ["./src/lib/convex-mock.tsx"],
      "@usehercules/auth/react": ["./src/lib/hercules-react-shim.ts"]
    }
  },
  "include": [
    "next-app/next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next-app/app/**/*.ts",
    "next-app/app/**/*.tsx",
    "src/server/**/*.ts",
    "src/server/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "next-app/proxy.ts",
    "next-app/instrumentation.ts",
    "next-app/next.config.ts",
    "db/**/*.ts",
    "drizzle.config.ts",
    "scripts/db/**/*.ts",
    "scripts/storage/**/*.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "convex",
    "src/pages",
    "src/components",
    "src/hooks",
    "src/lib"
  ]
}
