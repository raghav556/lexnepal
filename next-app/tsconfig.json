{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"], "@/convex/*": ["./convex/*"], "@usehercules/auth/react": ["./src/lib/hercules-react-shim.ts"]
    }
  },
  "include": [
    "next-env.d.ts", "types.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "proxy.ts",
    "instrumentation.ts",
    "next.config.ts",
    "../src/server/**/*.ts",
    "../src/shared/**/*.ts",
    "../src/client/**/*.ts"
  ],
  "exclude": ["../node_modules", "../src/pages", "../src/components", "../src/lib"]
}
