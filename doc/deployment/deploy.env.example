# Copy to ~/.config/lexnepal/deploy.env and fill outside this repository.
# Do not commit real credentials or production runtime secrets.

SERVER=deploy@example.com
SSH_PORT=22
# Optional: if key auth is not set up, provide the SSH password. deploy.sh then
# uses sshpass (must be installed) to authenticate non-interactively. When unset,
# OpenSSH prompts for the password interactively on a TTY.
SSH_PASSWORD=

APP_PATH=/home/USERNAME/apps/lexnepal
PUBLIC_HTML_PATH=/home/USERNAME/public_html

REMOTE_RESTART_MODE=passenger
PM2_APP_NAME=lexnepal
REMOTE_NODE_BIN=node
REMOTE_NODE_BIN_DIR=

RUNTIME_ENV_PATH=/home/USERNAME/apps/lexnepal/current/.env.runtime
WRITE_RUNTIME_ENV=0
RUNTIME_ENV_SOURCE=/home/USERNAME/.config/lexnepal/.env.runtime

READINESS_URL=https://example.com/api/v1/readiness
# Required for post-deploy checks of readiness, public CMS, version, and homepage navigation.
SMOKE_BASE_URL=https://example.com

# Optional safe build-time database URL. Use staging/sanitized data for preflight if a build needs
# database-backed static data. Do not point preflight at production unless that contact is approved.
BUILD_DATABASE_URL=

MIRROR_STATIC_TO_PUBLIC_HTML=0
DEPLOY_PREFLIGHT_ONLY=0

# Optional operator-controlled commands. Keep DB backup/restore ownership explicit.
REMOTE_BACKUP_COMMAND=
REMOTE_MIGRATION_COMMAND=
REMOTE_ROLLBACK_COMMAND=
